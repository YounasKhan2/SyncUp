{
  "name": "syncup",
  "private": true,
  "type": "module",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "test:integration": "node --test tests/messaging.integration.test.mjs",
    "typecheck": "npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/s3-request-presigner": "^3.1142.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "livekit-server-sdk": "^2.19.1",
    "pg": "^8.16.3",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.15.6",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.2"
  }
}
